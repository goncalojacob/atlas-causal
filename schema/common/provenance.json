{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common/provenance.json",
  "title": "Common envelope",
  "description": "The provenance every record carries. Kind schemas in v1/ reference these property definitions one by one, because the validator's keyword subset has no allOf.",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "supersededBy", "aliases", "authors", "license", "created", "revised", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "id": {
      "description": "Slug; immutable once merged; equals the file name.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": ["event", "edge", "source", "actor", "presence", "place", "relation", "narrative"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "merged", "retracted"]
    },
    "supersededBy": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/properties/id" }
      ]
    },
    "aliases": {
      "description": "Former ids only. Unique across all ids and all other aliases.",
      "type": "array",
      "items": { "$ref": "#/properties/id" }
    },
    "authors": {
      "description": "Contributors to this record, set from the issue opener by the Action. Never free text alone.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "github"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "github": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}$" }
            ]
          }
        }
      }
    },
    "license": {
      "description": "Validated per directory (rule 12). CC-BY-NC-SA-4.0 exists for imported geometry, which data/LICENSE does not cover; it is allowed under data/presences/ and, for the actors an import creates, under data/actors/.",
      "type": "string",
      "enum": ["CC-BY-SA-4.0", "CC-BY-NC-SA-4.0", "PD", "CC0-1.0", "ODbL-1.0"]
    },
    "created": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "revised": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/properties/created" }
      ]
    },
    "review": {
      "description": "What a reviewer should look at before signing this record, and why. Optional, and written by whoever drafted it; the review dashboard shows it as a filter and Sign removes it. Never a claim about the world — only about how much the record has been checked.",
      "type": "object",
      "required": ["flags"],
      "additionalProperties": false,
      "properties": {
        "flags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "note": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 500 }
          ]
        }
      }
    },
    "sources": {
      "description": "Citations. A citation points at a source record by id, with an optional locator (page, chapter, folio).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source"],
        "additionalProperties": false,
        "properties": {
          "source": { "$ref": "#/properties/id" },
          "locator": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "minLength": 1, "maxLength": 200 }
            ]
          }
        }
      }
    }
  }
}
