{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v1/event.json",
  "title": "Event",
  "description": "One point in space and time, or a long process with an interval and usually no place. An event points at a place record rather than repeating its coordinates; region is derived at index time from that place, and on the record it is an optional override, required when place is null.",
  "type": "object",
  "required": ["schema", "id", "kind", "status", "supersededBy", "aliases", "authors", "license", "created", "revised", "sources", "title", "summary", "when", "place", "actors"],
  "additionalProperties": false,
  "properties": {
    "schema": { "$ref": "../common/provenance.json#/properties/schema" },
    "id": { "$ref": "../common/provenance.json#/properties/id" },
    "kind": { "const": "event" },
    "status": { "$ref": "../common/provenance.json#/properties/status" },
    "supersededBy": { "$ref": "../common/provenance.json#/properties/supersededBy" },
    "aliases": { "$ref": "../common/provenance.json#/properties/aliases" },
    "authors": { "$ref": "../common/provenance.json#/properties/authors" },
    "license": { "$ref": "../common/provenance.json#/properties/license" },
    "created": { "$ref": "../common/provenance.json#/properties/created" },
    "revised": { "$ref": "../common/provenance.json#/properties/revised" },
    "review": { "$ref": "../common/provenance.json#/properties/review" },
    "sources": { "$ref": "../common/provenance.json#/properties/sources" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "summary": {
      "description": "Written by a person.",
      "type": "string",
      "minLength": 1
    },
    "when": { "$ref": "../common/interval.json" },
    "place": {
      "description": "The place record this event happened at, or null for a process with no honest point, which is then timeline-only and must carry a region.",
      "oneOf": [
        { "type": "null" },
        { "$ref": "../common/provenance.json#/properties/id" }
      ]
    },
    "region": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "../common/provenance.json#/properties/id" }
      ]
    },
    "actors": {
      "description": "The actors of this event and what each did in it — not everyone alive. Roles are free text for now; build-index.mjs emits the set in use so a closed vocabulary can be decided later. That every actor resolves is rule 14.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor", "role"],
        "additionalProperties": false,
        "properties": {
          "actor": { "$ref": "../common/provenance.json#/properties/id" },
          "role": { "type": "string", "minLength": 1, "maxLength": 60 }
        }
      }
    }
  }
}
